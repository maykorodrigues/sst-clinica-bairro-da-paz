{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playbook.ssfcard.ia.br/schemas/handoff.schema.json",
  "title": "Handoff entre agentes e para humano - Squad OpenClaw Comercial SST",
  "description": "Contrato de passagem de bastao. Vale entre agentes (A1 -> A2 -> A3) e do agente para humano. Um handoff sem resumo, sem motivo e sem proxima acao e rejeitado: e assim que contato se perde.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "created_at",
    "de",
    "para",
    "motivo",
    "urgencia",
    "conversa",
    "resumo",
    "proxima_acao",
    "guardrails"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4. Idempotencia: o mesmo handoff nao pode ser aceito duas vezes."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "de": {
      "type": "string",
      "description": "Agente ou pessoa que entrega.",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "humano"]
    },
    "para": {
      "type": "string",
      "description": "Quem recebe. 'humano_*' indica que sai do dominio da IA.",
      "enum": [
        "A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8",
        "humano_atendimento",
        "humano_closer",
        "humano_cobranca",
        "humano_cs",
        "humano_clinico",
        "humano_gestao"
      ]
    },
    "motivo": {
      "type": "string",
      "description": "Por que esta conversa muda de dono.",
      "enum": [
        "qualificado_para_venda",
        "precisa_fechar",
        "duvida_operacional",
        "ja_e_cliente",
        "assunto_financeiro",
        "risco_clinico",
        "urgencia",
        "reclamacao_formal",
        "pedido_de_humano",
        "fora_de_escopo",
        "limite_da_plataforma",
        "sem_resposta_apos_toques",
        "veto_do_guardiao",
        "falha_tecnica"
      ]
    },
    "urgencia": {
      "type": "string",
      "description": "critica = risco a pessoa ou risco juridico; atender imediatamente, sem fila.",
      "enum": ["critica", "alta", "normal", "baixa"]
    },
    "conversa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "record_id"],
      "description": "Referencia tecnica. Nunca carregar nome completo, CPF, telefone ou conteudo clinico aqui.",
      "properties": {
        "system": { "type": "string", "enum": ["e-chat", "gptmaker", "interno"] },
        "record_id": { "type": "string", "maxLength": 128 },
        "canal": {
          "type": "string",
          "enum": ["whatsapp_oficial", "instagram", "widget", "telefone", "presencial", "interno"]
        },
        "primeiro_contato_em": { "type": "string", "format": "date-time" },
        "ultima_mensagem_em": { "type": "string", "format": "date-time" },
        "toques_realizados": { "type": "integer", "minimum": 0 }
      }
    },
    "resumo": {
      "type": "array",
      "description": "Exatamente o que quem recebe precisa saber para nao fazer a pessoa repetir tudo. Tres linhas: quem e, o que quer, onde parou.",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 10, "maxLength": 300 }
    },
    "qualificacao": {
      "type": "object",
      "additionalProperties": false,
      "description": "Preenchido pelo A2 quando o handoff vem da pre-venda. SPIN sem dado clinico identificavel.",
      "properties": {
        "situacao": { "type": "string", "maxLength": 300 },
        "problema": { "type": "string", "maxLength": 300 },
        "implicacao": { "type": "string", "maxLength": 300 },
        "necessidade": { "type": "string", "maxLength": 300 },
        "classificacao": {
          "type": "string",
          "enum": ["quente", "morno", "frio", "nao_qualificado"]
        },
        "motivo_nao_qualificado": { "type": "string", "maxLength": 300 }
      }
    },
    "ja_prometido": {
      "type": "array",
      "description": "Tudo que ja foi dito a pessoa. Quem recebe precisa saber para nao contradizer. Promessa esquecida e a principal fonte de 'nao foi isso que me falaram'.",
      "items": { "type": "string", "maxLength": 300 },
      "default": []
    },
    "proxima_acao": {
      "type": "string",
      "description": "O que quem recebe deve fazer, em uma frase concreta e verificavel.",
      "minLength": 10,
      "maxLength": 300
    },
    "prazo": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Quando a proxima acao vence. null so e aceito quando urgencia = baixa.",
      "default": null
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sem_dado_sensivel", "sem_preco_nao_aprovado"],
      "properties": {
        "sem_dado_sensivel": {
          "type": "boolean",
          "description": "Confirma que nao ha CPF, laudo, exame, queixa clinica ou dado de terceiro neste handoff."
        },
        "sem_preco_nao_aprovado": { "type": "boolean" },
        "opt_out_verificado": { "type": "boolean", "default": true },
        "revisao_humana_obrigatoria": {
          "type": "boolean",
          "default": false,
          "description": "true quando o conteudo toca tema que exige revisao humana antes de qualquer uso."
        }
      }
    },
    "aceite": {
      "type": "object",
      "additionalProperties": false,
      "description": "Preenchido por quem recebe. Handoff nao aceito volta para o emissor - nunca fica orfao.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pendente", "aceito", "devolvido"],
          "default": "pendente"
        },
        "por": { "type": ["string", "null"], "default": null },
        "em": { "type": ["string", "null"], "format": "date-time", "default": null },
        "motivo_devolucao": { "type": ["string", "null"], "maxLength": 300, "default": null }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "urgencia": { "const": "critica" } },
        "required": ["urgencia"]
      },
      "then": {
        "properties": {
          "para": {
            "enum": [
              "humano_atendimento",
              "humano_clinico",
              "humano_gestao",
              "humano_closer",
              "humano_cobranca",
              "humano_cs"
            ]
          }
        },
        "required": ["prazo"]
      }
    },
    {
      "if": {
        "properties": { "motivo": { "enum": ["risco_clinico", "urgencia"] } },
        "required": ["motivo"]
      },
      "then": {
        "properties": {
          "urgencia": { "const": "critica" }
        }
      }
    }
  ],
  "examples": [
    {
      "handoff_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "created_at": "2026-08-21T10:02:00-03:00",
      "de": "A1",
      "para": "humano_atendimento",
      "motivo": "risco_clinico",
      "urgencia": "critica",
      "conversa": {
        "system": "e-chat",
        "record_id": "conv-000-exemplo-ficticio",
        "canal": "whatsapp_oficial",
        "primeiro_contato_em": "2026-08-21T09:58:00-03:00",
        "ultima_mensagem_em": "2026-08-21T10:01:00-03:00",
        "toques_realizados": 1
      },
      "resumo": [
        "Contato ficticio de demonstracao, primeira vez que escreve no canal.",
        "Relatou mal-estar e pediu atendimento no mesmo dia - conteudo clinico nao transcrito aqui.",
        "Agente parou na primeira resposta e nao ofereceu orientacao de saude."
      ],
      "ja_prometido": [
        "Foi dito que alguem da equipe entraria em contato agora."
      ],
      "proxima_acao": "Atendente humano assume a conversa imediatamente e orienta sobre atendimento presencial ou servico de emergencia.",
      "prazo": "2026-08-21T10:07:00-03:00",
      "guardrails": {
        "sem_dado_sensivel": true,
        "sem_preco_nao_aprovado": true,
        "opt_out_verificado": true,
        "revisao_humana_obrigatoria": true
      },
      "aceite": {
        "status": "pendente",
        "por": null,
        "em": null,
        "motivo_devolucao": null
      }
    }
  ]
}
